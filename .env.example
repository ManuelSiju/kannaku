# Kanakku server config. Copy to .env (make setup does this) and edit.

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8013

# --- LLM: any OpenAI-compatible endpoint -----------------------------------
LLM_BACKEND=ollama            # ollama | llamacpp  (what make up starts if nothing is running)
# for llamacpp: path to the .gguf (and optional vision projector)
LLAMA_MODEL_PATH=
LLAMA_MMPROJ_PATH=
# Ollama (default for dev):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=local
LLM_VISION_ENABLED=false
LLM_VISION_MODEL=              # optional model for image calls, e.g. qwen2.5vl:7b
LLM_TEMPERATURE=0.2
# llama.cpp llama-server instead:
#   LLM_BASE_URL=http://localhost:8080/v1
#   LLM_MODEL=local-model
# Meta Model API: do not edit the LLM_* lines. `make up` asks for the key (or use PROVIDER=meta|local) and then
# points the server at META_BASE_URL / META_MODEL with vision on. The local backend is not started for Meta.
LLM_TIMEOUT_S=20
LLM_MAX_CALLS_PER_ASK=4

# --- Speech-to-text ----------------------------------------------------------
STT_PROVIDER=faster_whisper   # faster_whisper | meta
WHISPER_MODEL=medium          # medium | large-v3 | small ...
WHISPER_DEVICE=auto           # auto | cpu | cuda
STT_LANGUAGE=en               # en for now; empty = auto-detect (multilingual later)

# --- Text-to-speech ----------------------------------------------------------
TTS_PROVIDER=device           # device (app speaks) | none

# --- OCR ---------------------------------------------------------------------
OCR_LANGS=eng                 # eng for now; eng+mal later

# --- Storage / data ----------------------------------------------------------
DB_PATH=server/kanakku.db
REFERENCE_RATES_PATH=server/data/reference_rates.json

# --- Meta Model API (chosen at make up) ------------------------------------------
# Keep the key OUT of this file: make up offers to save it in .env.local (gitignored, mode 600).
# META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
LLM_CACHE=true                # Meta only: identical prompts are answered from the SQLite cache (no call)
META_MAX_CALLS_PER_DAY=300    # Meta only: daily call cap (warning at 80%)
LLM_FALLBACK=none             # none = asks fail at the cap; local = answer with the local models (badge shown)

# --- Reliability ----------------------------------------------------------------
# KANAKKU_TOKEN is generated by make up into .env.local; the app sends it as "Authorization: Bearer <token>".
MAX_AUDIO_MB=10
MAX_IMAGE_MB=8
MAX_PDF_MB=15
MAX_FILES=5
REQUEST_TIMEOUT_S=180
ASKS_PER_MINUTE=20            # per device (X-Device-ID header, else IP)
LOG_PATH=run/server.log       # JSON lines, rotated 10 MB x 5
BACKUP_DIR=run/backups        # daily copy of the database, newest 3 kept
